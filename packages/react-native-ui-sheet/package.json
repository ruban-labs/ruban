{
  "name": "@ruban-labs/react-native-ui-sheet",
  "version": "0.1.0",
  "description": "Bottom sheets and selection sheets for bare React Native.",
  "keywords": ["react-native", "ui", "bottom-sheet", "modal", "select"],
  "license": "MIT",
  "homepage": "https://github.com/ruban-labs/ruban/tree/main/packages/react-native-ui-sheet",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruban-labs/ruban.git",
    "directory": "packages/react-native-ui-sheet"
  },
  "source": "src/index",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["src", "lib", "NOTICE", "!**/__tests__"],
  "publishConfig": {"access": "public"},
  "sideEffects": false,
  "scripts": {
    "build": "bob build",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ruban-labs/react-native-ui-overlay": "^0.1.0",
    "@ruban-labs/react-native-ui-theme": "^0.1.0",
    "react": ">=17.0.0",
    "react-native": ">=0.66.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "ruban": {
    "reactNativeFloor": "0.66.0",
    "runtimePolicy": "zero-dependency",
    "nativeCode": false
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@ruban-labs/react-native-ui-overlay": "workspace:*",
    "@ruban-labs/react-native-ui-theme": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.0",
    "jest": "^29.7.0",
    "react": "19.2.8",
    "react-native": "0.87.0",
    "react-native-builder-bob": "^0.43.0",
    "react-native-safe-area-context": "5.5.2",
    "typescript": "^5.8.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      ["typescript", {"project": "tsconfig.build.json"}]
    ]
  }
}
