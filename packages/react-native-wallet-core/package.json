{
  "name": "@ruban-labs/react-native-wallet-core",
  "version": "0.1.0",
  "description": "Native EVM vault, derivation, and signing for bare React Native.",
  "keywords": ["react-native", "evm", "wallet", "rust", "native-module"],
  "license": "MIT",
  "homepage": "https://github.com/ruban-labs/ruban/tree/main/packages/react-native-wallet-core",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruban-labs/ruban.git",
    "directory": "packages/react-native-wallet-core"
  },
  "source": "src/index",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "rust",
    "react-native.config.js",
    "RubanWalletCore.podspec",
    "NOTICE",
    "!**/__tests__",
    "!rust/target"
  ],
  "publishConfig": {"access": "public"},
  "sideEffects": false,
  "scripts": {
    "build": "bob build && pnpm build:rust:host",
    "build:native": "node scripts/build-native.mjs --platform all",
    "build:native:android": "node scripts/build-native.mjs --platform android",
    "build:native:ios": "node scripts/build-native.mjs --platform ios",
    "build:rust:host": "node scripts/run-cargo.mjs build --release",
    "test": "jest --passWithNoTests && pnpm test:rust",
    "test:rust": "node scripts/run-cargo.mjs test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.66.0"
  },
  "ruban": {
    "reactNativeFloor": "0.66.0",
    "runtimePolicy": "native-contained",
    "nativeCode": true
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.0",
    "jest": "^29.7.0",
    "react": "19.2.8",
    "react-native": "0.87.0",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "^5.8.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": ["commonjs", "module", "typescript"]
  }
}
