{
  "name": "@ruban-labs/react-native-worker-thread",
  "version": "0.1.0",
  "description": "Bounded, named worker-runtime foundation for bare React Native.",
  "keywords": [
    "react-native",
    "worker",
    "thread",
    "hermes",
    "jsi",
    "bare-react-native"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ruban-labs/ruban/tree/main/packages/react-native-worker-thread",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruban-labs/ruban.git",
    "directory": "packages/react-native-worker-thread"
  },
  "source": "src/index",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/commonjs/index.js"
    },
    "./worker": {
      "types": "./lib/typescript/worker.d.ts",
      "react-native": "./src/worker.ts",
      "default": "./lib/commonjs/worker.js"
    },
    "./testing": {
      "types": "./lib/typescript/testing.d.ts",
      "react-native": "./src/testing.ts",
      "default": "./lib/commonjs/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "examples",
    "worker.js",
    "worker.d.ts",
    "testing.js",
    "testing.d.ts",
    "NOTICE",
    "react-native.config.js",
    "!cpp/tests",
    "!**/__tests__"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "bob build",
    "build:native:android": "node scripts/core-smoke.mjs",
    "build:native:ios": "node scripts/core-smoke.mjs",
    "test": "jest && node scripts/core-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.66.0"
  },
  "ruban": {
    "reactNativeFloor": "0.66.0",
    "runtimePolicy": "bare-react-native",
    "nativeCode": true
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.0",
    "jest": "^29.7.0",
    "react": "19.2.8",
    "react-native": "0.87.0",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "^5.8.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}
