{
  "name": "@ruban-labs/react-native-ui-overlay",
  "version": "0.1.0",
  "description": "A single-host overlay coordinator for reliable React Native modal composition.",
  "keywords": ["react-native", "ui", "overlay", "modal", "dialog"],
  "license": "MIT",
  "homepage": "https://github.com/ruban-labs/ruban/tree/main/packages/react-native-ui-overlay",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruban-labs/ruban.git",
    "directory": "packages/react-native-ui-overlay"
  },
  "source": "src/index",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/commonjs/index.js"
    },
    "./coordinator": {
      "types": "./lib/typescript/OverlayCoordinator.d.ts",
      "react-native": "./src/OverlayCoordinator.ts",
      "default": "./lib/commonjs/OverlayCoordinator.js"
    },
    "./host": {
      "types": "./lib/typescript/OverlayHost.d.ts",
      "react-native": "./src/OverlayHost.tsx",
      "default": "./lib/commonjs/OverlayHost.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "coordinator.js",
    "coordinator.d.ts",
    "host.js",
    "host.d.ts",
    "NOTICE",
    "!**/__tests__"
  ],
  "publishConfig": {"access": "public"},
  "sideEffects": false,
  "scripts": {
    "build": "bob build",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.66.0"
  },
  "ruban": {
    "reactNativeFloor": "0.66.0",
    "runtimePolicy": "zero-dependency",
    "nativeCode": false
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.0",
    "jest": "^29.7.0",
    "react": "19.2.8",
    "react-native": "0.87.0",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "^5.8.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": ["commonjs", "module", "typescript"]
  }
}
