{
  "name": "@ruban-labs/react-native-progress",
  "version": "6.0.0",
  "description": "Progress indicators and spinners for React Native. Zero dependencies, bare-RN first, new architecture ready. Refurbished from oblador/react-native-progress.",
  "keywords": [
    "react-native",
    "progress",
    "progressbar",
    "spinner",
    "pie",
    "circle",
    "loading",
    "new-architecture"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ruban-labs/ruban/tree/main/packages/react-native-progress",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruban-labs/ruban.git",
    "directory": "packages/react-native-progress"
  },
  "source": "src/index",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.tsx",
      "default": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "NOTICE",
    "!**/__tests__"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "bob build",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.66.0"
  },
  "ruban": {
    "reactNativeFloor": "0.66.0",
    "runtimePolicy": "zero-dependency",
    "nativeCode": false
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^29.7.0",
    "react": "19.2.8",
    "react-native": "0.87.0",
    "react-native-builder-bob": "^0.43.0",
    "react-test-renderer": "19.2.8",
    "typescript": "^5.8.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}
