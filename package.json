{
  "name": "ruban",
  "private": true,
  "description": "Ruban Labs - small, sharp React Native tools. Measure with the ruler, build with the tools.",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "check:syntax": "node scripts/ci/check-syntax-floor.mjs",
    "gongshu:package": "node scripts/release/package.mjs",
    "gongshu:release-health": "node scripts/device/release-health.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "acorn": "^8.18.0"
  }
}
