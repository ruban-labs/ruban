---
import SiteLayout from '../layouts/SiteLayout.astro';

const sections = [
  {
    title: 'Data collection',
    body: 'The current release contains no advertising, analytics, or third-party tracking SDK. Ruban Labs does not receive personal information, device identifiers, usage history, or precise location from the app.',
  },
  {
    title: 'On-device activity',
    body: 'Interface preferences, component demo state, and deep-link state are handled on the device. Ruban Labs does not receive this state. Removing the app removes its local app data, subject to operating system backup behavior.',
  },
  {
    title: 'Permissions',
    body: 'The current release does not request access to contacts, camera, microphone, photos, or precise location. If a future feature needs a system permission, the app will explain it before requesting access.',
  },
  {
    title: 'External services',
    body: 'The app can open Ruban pages on GitHub or npm in your browser. Those services process activity under their own privacy policies. Apple or Google may also process store distribution and optional diagnostic information under their respective policies.',
  },
  {
    title: 'Retention and deletion',
    body: 'Because Ruban Labs does not collect personal data through Ruban Mobile, it has no app-collected personal data to retain or delete.',
  },
  {
    title: 'Policy changes',
    body: 'If a future release changes its data practices, this page and the relevant app-store disclosures will be updated before that release.',
  },
];
---

<SiteLayout
  currentPath="/privacy/"
  title="Privacy — Ruban"
  description="Privacy policy for Ruban Mobile by Ruban Labs."
>
  <div class="legal frame">
    <div class="legal-heading">
      <p class="kicker">RUBAN MOBILE / DISCLOSURE</p>
      <h1>Privacy</h1>
      <div class="legal-meta">
        <span><small>EFFECTIVE</small>2026-08-30</span>
        <span><small>APPLIES TO</small>RUBAN MOBILE</span>
      </div>
    </div>

    <p class="legal-lead">
      Ruban Mobile does not require an account and does not collect, transmit, sell, or share
      personal data.
    </p>

    <div class="legal-grid">
      <aside aria-label="Policy summary">
        <div><span>ACCOUNT</span><strong>NONE</strong></div>
        <div><span>ADVERTISING</span><strong>NONE</strong></div>
        <div><span>ANALYTICS</span><strong>NONE</strong></div>
        <div><span>TRACKING</span><strong>NONE</strong></div>
      </aside>

      <article>
        {
          sections.map((section, index) => (
            <section>
              <span class="legal-index">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h2>{section.title}</h2>
                <p>{section.body}</p>
              </div>
            </section>
          ))
        }
        <section>
          <span class="legal-index">07</span>
          <div>
            <h2>Contact</h2>
            <p>Privacy and support questions can be submitted through the Ruban public issue tracker.</p>
            <a
              class="text-link"
              href="https://github.com/ruban-labs/ruban/issues/new"
              target="_blank"
              rel="noreferrer noopener"
            >
              Open an issue <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>
      </article>
    </div>
  </div>
</SiteLayout>
