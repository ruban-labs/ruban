---
import SiteLayout from '../layouts/SiteLayout.astro';

const sections = [
  {
    title: 'Data collection',
    body: 'Ruban does not include an advertising or analytics SDK. The earlier store release is a component showcase. The website portfolio preview adds optional third-party data requests described below; it does not route those requests through a Ruban Labs server.',
  },
  {
    title: 'On-device activity',
    body: 'Preferences, saved addresses and cached portfolio snapshots are stored on your device. The example portfolio uses synthetic data and does not need a data-provider request. AccessKeys are stored through native platform credential storage, not in the portfolio database. Builds that offer local wallet import also keep wallet secrets in native device storage; importing them is not needed to watch an address.',
  },
  {
    title: 'Permissions',
    body: 'The current release does not request access to contacts, camera, microphone, photos, or precise location. If a future feature needs a system permission, the app will explain it before requesting access.',
  },
  {
    title: 'External services',
    body: 'When you refresh a real address with your DeBank Cloud key, the app sends the address and your AccessKey directly to DeBank Cloud. RPC requests send the relevant address or transaction parameters to the selected network endpoint. Providers see your IP address and may retain request records under their own policies. Token and protocol images can be loaded from remote image hosts, which also receive your IP address. Websites opened in the DApp browser have their own data practices; approved connections can disclose the selected public address. GitHub, npm, Apple and Google process downloads or visits under their respective policies.',
  },
  {
    title: 'Retention and deletion',
    body: 'Remove a DeBank key in Settings → Data source. This stops future authenticated refreshes but does not delete cached portfolios or revoke the key at DeBank. Delete saved addresses through the address selector. Local app storage is subject to operating-system backup and credential-retention behavior. Contact the relevant external provider about its retained request data; deleting local data does not erase provider records.',
  },
  {
    title: 'Policy changes',
    body: 'If a future release changes its data practices, this page and the relevant app-store disclosures will be updated before that release.',
  },
];
---

<SiteLayout
  currentPath="/privacy/"
  title="Privacy — Ruban"
  description="Privacy policy for Ruban Mobile by Ruban Labs."
>
  <div class="legal frame">
    <div class="legal-heading">
      <p class="kicker">RUBAN MOBILE / DISCLOSURE</p>
      <h1>Privacy</h1>
      <div class="legal-meta">
        <span><small>EFFECTIVE</small>2026-09-24</span>
        <span><small>APPLIES TO</small>RUBAN MOBILE</span>
      </div>
    </div>

    <p class="legal-lead">
      Ruban Mobile does not require an account with Ruban Labs. Example portfolios work
      without a key. Live portfolio and DApp features communicate with external providers.
    </p>

    <div class="legal-grid">
      <aside aria-label="Policy summary">
        <div><span>ACCOUNT</span><strong>NONE</strong></div>
        <div><span>ADVERTISING</span><strong>NONE</strong></div>
        <div><span>ANALYTICS</span><strong>NONE</strong></div>
        <div><span>TRACKING</span><strong>NONE</strong></div>
      </aside>

      <article>
        {
          sections.map((section, index) => (
            <section>
              <span class="legal-index">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h2>{section.title}</h2>
                <p>{section.body}</p>
              </div>
            </section>
          ))
        }
        <section>
          <span class="legal-index">07</span>
          <div>
            <h2>Contact</h2>
            <p>Privacy and support questions can be submitted through the Ruban public issue tracker.</p>
            <a
              class="text-link"
              href="https://github.com/ruban-labs/ruban/issues/new"
              target="_blank"
              rel="noreferrer noopener"
            >
              Open an issue <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>
      </article>
    </div>
  </div>
</SiteLayout>
